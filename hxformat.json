{
	"lineEnds": {
		"leftCurly": "after",
		"rightCurly": "both",
		"objectLiteralCurly": {
			"leftCurly": "none"
		},
		"emptyCurly": "break"
	},
	"sameLine": {
		"ifElse": "same",
		"doWhile": "same",
		"tryBody": "same",
		"tryCatch": "same",
		"functionBody": "next",
		"anonFunctionBody": "same",
		"caseBody": "same"
	},
	"indentation": {
		"trailingWhitespace": true,
		"character": "\t"
	},
	"emptyLines": {
		"enumAbstractEmptyLines": {
			"beginType": 0,
			"endType": 1,
			"betweenVars": 0,
			"afterVars": 1,
			"betweenFunctions": 1,
			"existingBetweenFields": "keep"
		},
		"importAndUsing": {
			"betweenImportsLevel": "firstLevelPackage",
			"betweenImports": 1,
			"beforeUsing": 1
		},
		"betweenTypes": 1,
		"betweenSingleLineTypes": 1,
		"maxAnywhereInFile": 1
	},
	"whitespace": {
		"colonPolicy": "around",
		"caseColonPolicy": "onlyAfter",
		"objectFieldColonPolicy": "onlyAfter",
		"typeHintColonPolicy": "onlyAfter",
		"typeCheckColonPolicy": "around",
		"ternaryPolicy": "around",
		"arrowFunctionsPolicy": "around",
		"functionTypeHaxe3Policy": "around",
		"functionTypeHaxe4Policy": "around",
		"parenConfig": {
			"catchParens": {
				"openingPolicy": "none",
				"closingPolicy": "onlyAfter"
			},
			"ifConditionParens": {
				"openingPolicy": "none",
				"closingPolicy": "onlyAfter"
			},
			"forLoopParens": {
				"openingPolicy": "none",
				"closingPolicy": "onlyAfter"
			},
			"sharpConditionParens": {
				"openingPolicy": "none",
				"closingPolicy": "none"
			},
			"switchConditionParens": {
				"openingPolicy": "none",
				"closingPolicy": "onlyAfter"
			},
			"whileConditionParens": {
				"openingPolicy": "none",
				"closingPolicy": "onlyAfter"
			},
			"funcParamParens": {
				"openingPolicy": "none",
				"closingPolicy": "onlyAfter",
				"removeInnerWhenEmpty": true
			},
			"anonFuncParamParens": {
				"openingPolicy": "none",
				"closingPolicy": "onlyAfter",
				"removeInnerWhenEmpty": true
			}
		},
		"bracesConfig": {
			"anonTypeBraces": {
				"openingPolicy": "before",
				"closingPolicy": "onlyAfter",
				"removeInnerWhenEmpty": true
			},
			"blockBraces": {
				"openingPolicy": "before",
				"closingPolicy": "onlyAfter",
				"removeInnerWhenEmpty": true
			},
			"objectLiteralBraces": {
				"openingPolicy": "before",
				"closingPolicy": "onlyAfter",
				"removeInnerWhenEmpty": true
			},
			"typedefBraces": {
				"openingPolicy": "before",
				"closingPolicy": "onlyAfter",
				"removeInnerWhenEmpty": true
			},
			"unknownBraces": {
				"openingPolicy": "noneBefore",
				"closingPolicy": "onlyAfter",
				"removeInnerWhenEmpty": true
			}
		}
	},
	"wrapping": {
		"callParameter": {
			"defaultWrap": "noWrap",
			"rules": [
				{
					"conditions": [
						{
							"cond": "exceedsMaxLineLength",
							"value": 1
						}
					],
					"type": "onePerLine"
				}
			]
		},
		"maxLineLength": 100
	}
}